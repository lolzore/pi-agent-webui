    <!--
      Built unpackaged: the MSIX wrapper project (PiAgent.Package) needs the
      "Windows Application Packaging Project" VS component, which is not installed
      here, and the Windows App SDK runtime 1.8 is already on the machine.

      Without this, WinAppSDK assumes the process came from an MSIX package, skips
      the bootstrapper, cannot resolve the framework package, and the app dies at
      startup with 0xc0000409 in ucrtbase.dll. Setting WindowsPackageType=None on
      the *application* project (libraries must not get it, or they fail to link
      MddBootstrapInitialize2) makes the WinAppSDK auto-initializer call
      MddBootstrapInitialize for us.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Carry the Windows App SDK with the app instead of resolving it from an
      installed framework package. The unpackaged bootstrapper fail-fasts
      (0xc0000409 in ucrtbase.dll) unless the installed Microsoft.WindowsAppRuntime
      version satisfies the version the app was built against, and the machine's
      1.8 runtime is older than the 1.8.260508005 NuGet RNW 0.84 pulls in.
      Self-contained sidesteps that entirely and is the documented choice for
      unpackaged desktop apps. Costs ~60 MB next to the exe.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
